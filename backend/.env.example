APP_ENV=development
DATABASE_URL=postgresql+psycopg://careflow:careflow@localhost:5432/careflow
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me
SESSION_MAX_AGE_SECONDS=604800
# Auth: demo mode is explicit and server-side only
DEMO_AUTH_ENABLED=true
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
# Gemini - verify model availability before use
GEMINI_API_KEY=
GEMINI_MODEL=
# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Presage
PRESAGE_API_KEY=
# Snowflake Cortex Search (public trial data only; unset = existing cache/live search)
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
SNOWFLAKE_DATABASE=CAREFLOW
SNOWFLAKE_SCHEMA=TRIALS
SNOWFLAKE_SEARCH_SERVICE=TRIAL_SEARCH
SNOWFLAKE_WAREHOUSE=CAREFLOW_WH
